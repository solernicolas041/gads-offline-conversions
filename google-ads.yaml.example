# Copy to google-ads.yaml and fill in. That file is git-ignored.
#
# developer_token   Google Ads UI -> Tools -> API Center (Basic access is enough)
# client_id/secret  Google Cloud Console -> Credentials -> OAuth client ID (Desktop app)
# refresh_token     python generate_refresh_token.py
# login_customer_id your MCC id, digits only. For a standalone account, use that account.

developer_token: YOUR_DEVELOPER_TOKEN
client_id: YOUR_CLIENT_ID.apps.googleusercontent.com
client_secret: YOUR_CLIENT_SECRET
refresh_token: YOUR_REFRESH_TOKEN
login_customer_id: 1234567890
use_proto_plus: true
